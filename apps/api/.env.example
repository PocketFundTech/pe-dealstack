# Supabase Configuration
# Get these from https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"

# Server Configuration
PORT=3001
NODE_ENV=development

# ─── LLM provider keys ──────────────────────────────────────────────
# Tier-1 callsites (deal chat, memos, extraction reasoning, analysis)
# now route to Anthropic DIRECT via @langchain/anthropic when
# ANTHROPIC_API_KEY is present. On error or when the key is missing
# they fall back to OpenAI direct (gpt-4o) via OPENAI_API_KEY.
#
# Routing cascade for tier-1 (transparent fallback at the .invoke layer):
#   1. ANTHROPIC_API_KEY            → Anthropic direct, primary key
#   2. ANTHROPIC_API_KEY_FALLBACK   → Anthropic direct, secondary key
#                                     (auto-triggered on credit/rate/auth
#                                      error from primary; same model)
#   3. OPENAI_API_KEY               → OpenAI direct (gpt-4o)
#   4. (legacy) OPENROUTER_API_KEY  → OpenRouter, anthropic/claude-sonnet-4.6
#
# Tiers 2-4 (classification, fast tasks) still route via OpenAI direct
# or OpenRouter if OPENROUTER_API_KEY is set.

# Anthropic Configuration (preferred tier-1 provider)
# Get your API key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# Anthropic secondary key — used as the first fallback when the primary
# key returns a credit/rate/auth error. Lets the system keep Claude-grade
# responses (instead of dropping straight to GPT) when one account hits
# its monthly credit cap. Optional but recommended. Same key format.
ANTHROPIC_API_KEY_FALLBACK=

# OpenAI Configuration (final tier-1 fallback + default tier-2/3/4 provider)
# Used when BOTH Anthropic keys above are exhausted. Also the default for
# tiers 2-4 (classification, fast tasks).
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key

# OpenRouter Configuration (LEGACY tier-1 path; still usable for tiers 2-4)
# When set, OPENAI_API_KEY-using callsites pivot to openrouter.ai and the
# tier-2/3/4 prefixed model IDs ("openai/gpt-4.1", ...) take effect.
# OPENROUTER_API_KEY=sk-or-your-openrouter-key

# Gemini API Configuration (for RAG)
# Get your API key from https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# ─── LLM model overrides (optional) ─────────────────────────────────
# Override the default model per tier. All optional — leave unset to use
# the in-code defaults (see services/llm.ts MODELS.anthropic). Setting a
# value here WINS over the code default.
#   LLM_CHAT_MODEL  — tier-1 chat/reasoning model. Default: claude-sonnet-4-6
#   LLM_FAST_MODEL  — fast/cheap tier. Default: claude-haiku-4-5-20251001
# Use exact Anthropic model ids (hyphenated, no date suffix on aliases).
# LLM_CHAT_MODEL=claude-sonnet-4-6
# LLM_FAST_MODEL=claude-haiku-4-5-20251001

# Tavily search API keys — power the web_search tool in dealChat agent.
# Primary key is used first; fallback rolls in on HTTP 429/432 (rate limit
# or credits exhausted). Both are optional in dev — tool returns a polite
# "not configured" message if TAVILY_API_KEY is unset. Get keys at
# https://app.tavily.com (free dev tier ships with 1k credits/month).
TAVILY_API_KEY=
TAVILY_API_KEY_FALLBACK=

# ─── Outreach contact enrichment (optional, Cicero Capital board only) ──
# Powers the "Enrich" action on the Outreach pipeline board (POST
# /api/outreach/contacts/:id/enrich — see services/outreachEnrichment.ts).
# Each provider is independently optional: unset = that provider is
# silently skipped (not an error), same soft-fail pattern as the LLM keys
# above. Set any subset now; the route activates them automatically, no
# code changes needed.

# Apollo.io — People Match/Enrich API. Get a key from
# https://app.apollo.io/#/settings/integrations/api (Settings -> API).
APOLLO_API_KEY=

# Anymail Finder — Find a Person's Email API. Get a key from
# https://anymailfinder.com/dashboard/api.
ANYMAIL_FINDER_API_KEY=

# Clay — NOT a synchronous "enrich and get data back" API like the two
# above (Clay has no fixed API host or public REST spec for this). Both of
# these are required together to enable Clay at all:
#   CLAY_API_KEY      — sent as the Authorization: Bearer header on our
#                        webhook POST. Get one from Clay workspace settings.
#   CLAY_WEBHOOK_URL   — the per-table webhook URL a human generates inside
#                        Clay's UI (Sources -> Webhook) for a table with the
#                        desired enrichment columns configured. There is no
#                        default/shared URL — every workspace's is unique.
# We POST the contact to CLAY_WEBHOOK_URL and Clay enriches it
# asynchronously (minutes, not milliseconds); this integration only submits
# the row today — see services/outreachEnrichment.ts's Clay comment block
# for why a synchronous round trip isn't how Clay actually works.
CLAY_API_KEY=
CLAY_WEBHOOK_URL=

# ─── LangSmith tracing (optional, for debugging LangChain runs) ─────
# When all four are set, every LangChain / LangGraph call (deal-chat
# agent, memo pipeline, financial agent, email drafter, etc.) auto-
# traces to https://smith.langchain.com under the named project. Raw
# Anthropic / OpenAI SDK calls are wrapped via langsmith/wrappers
# (services/anthropic.ts, financialAgent/nodes/verifyNode.ts) so they
# trace too. Leave unset to disable tracing entirely.
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_pt_<paste-from-langsmith-dashboard>
LANGSMITH_PROJECT=dealstack

# LangExtract Deep Extraction (optional)
# Python microservice for long document extraction (>50k chars)
# Run: cd apps/extractor && python server.py
EXTRACTOR_URL=http://localhost:5050

# Data Encryption Key (optional)
# AES-256-GCM encryption for sensitive deal fields at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without this key, data is stored in plaintext (graceful degradation for dev).
DATA_ENCRYPTION_KEY=

# Azure Document Intelligence (optional — Layer 1 for financial table extraction)
# When set, Azure prebuilt-layout runs first on PDFs for best table quality.
# Falls back to GPT-4o text / Vision if not configured.
# Get endpoint + key: https://portal.azure.com → Azure AI services → Document Intelligence
AZURE_DOC_INTEL_ENDPOINT=
AZURE_DOC_INTEL_KEY=

# App URL (required in production — used for invitation/share links in emails)
APP_URL=https://your-production-domain.com

# Resend Email Service (required for invitations + document sharing)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# CORS — Additional allowed origins (comma-separated, optional)
# Default allowlist already includes lmmos.ai (+ www) and Vercel preview
# domains. Use this only if you need to add a one-off origin.
ALLOWED_ORIGINS=

# Sentry Error Tracking (optional)
# Get your DSN from https://sentry.io/settings/projects/
SENTRY_DSN=

# Integrations platform (Phase 0)
OAUTH_STATE_SECRET=                # 32+ chars, used for HMAC of OAuth state JWT
CRON_SECRET=                       # shared secret between Vercel cron and the API

# Granola (Phase 1) — base URL only; users paste their own grn_ keys via UI.
GRANOLA_API_BASE=https://public-api.granola.ai

# Gmail (Phase 2) + Google Calendar (Phase 3) — shared Google OAuth client credentials.
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs (add both):
#   ${APP_URL}/api/integrations/oauth/gmail/callback
#   ${APP_URL}/api/integrations/oauth/google_calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outlook + Microsoft 365 — shared Microsoft (Entra/Azure AD) app registration.
# Register at https://portal.azure.com → Entra ID → App registrations.
#   - Account type: multitenant (any org + personal MS accounts)
#   - Add a client secret (Certificates & secrets) → MS_CLIENT_SECRET
#   - Microsoft Graph DELEGATED permissions:
#       offline_access openid email profile User.Read
#       Mail.Read (Outlook) · Calendars.Read + Files.Read.All (Microsoft 365: calendar + OneDrive)
# Authorized redirect URIs (add both):
#   ${APP_URL}/api/integrations/oauth/outlook/callback
#   ${APP_URL}/api/integrations/oauth/microsoft365/callback
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common                   # 'common' for multitenant; or a specific tenant id
# OUTLOOK_CLASSIFIER_CAP_PER_RUN=200  # optional: max classifier (LLM) calls per Outlook sync

# ============================================================
# AI Usage Tracking
# ============================================================
# Per-unit prices for non-LLM providers (used by the cost ledger).
# Tune to match your Apify / Azure dashboard rates.
APIFY_PRICE_PER_SEARCH_USD=0.005
APIFY_PRICE_PER_LINKEDIN_PROFILE_USD=0.02
AZURE_DOC_PRICE_PER_PAGE_USD=0.0015

# Per-1K-character price for Gemini text-embedding-004 (used by RAG ingest
# + retrieval). Verify against Google's current rate; a generous free tier
# exists at low volume, but cost ≠ 0 above quota.
GEMINI_EMBED_PRICE_PER_1K_CHARS_USD=0.000025

# ── Phase 1: Claude extraction engine ──
# Engine flag: legacy (default) | claude
EXTRACTION_ENGINE=legacy
# Role model overrides (defaults: claude-fable-5 / claude-sonnet-5 / claude-haiku-4-5)
# AI_EXTRACTION_MODEL=claude-opus-4-8
# AI_CHAT_MODEL=claude-sonnet-5
# AI_FAST_MODEL=claude-haiku-4-5

# ── Phase 2-B: Research & Signals on Managed Agents ──
# See docs/superpowers/specs/2026-08-04-research-signals-managed-agents-design.md
RESEARCH_ENGINE=legacy          # legacy | managed-agents
SIGNAL_ENGINE=legacy            # legacy | managed-agents
MANAGED_AGENTS_ENVIRONMENT_ID=
MANAGED_AGENTS_FIRM_RESEARCH_AGENT_ID=
MANAGED_AGENTS_SIGNAL_MONITOR_AGENT_ID=
AI_AGENT_MODEL=claude-sonnet-5
CRON_SECRET=
ANTHROPIC_WEBHOOK_SIGNING_KEY=
