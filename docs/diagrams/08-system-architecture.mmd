%% PE OS — System Architecture
%% Last verified 2026-08-14 (V2: Anthropic-first AI layer, memo grading + streaming, scorecard, client portal, usage ledger).
flowchart TB
    subgraph WebNext["Next.js App — apps/web-next :3002 (PRIMARY, Vercel root)"]
        direction TB
        subgraph NextRoutes["App Router Routes"]
            direction LR
            WN_Dashboard["dashboard"]
            WN_Deals["deals — pipeline + detail
            scorecard · chat · share"]
            WN_DataRoom["data-room — VDR"]
            WN_Memo["memo-builder
            live section streaming"]
            WN_Contacts["contacts"]
            WN_Graphs["graphs"]
            WN_NDA["nda — legal docs"]
            WN_Usage["internal/usage
            AI usage ledger"]
            WN_Portal["portal/[token]
            PUBLIC share view, no auth"]
            WN_Settings["settings
            incl. investment criteria"]
            WN_Onboarding["onboarding"]
            WN_Admin["admin · templates · deal-intake"]
        end
        subgraph NextStack["React 19 + Next 16 + Tailwind v4"]
            direction LR
            ApiProxy["/api/[...slug]
            proxies → Express API"]
            ApiClient["lib/api.ts
            SSE streaming client
            + legacy JSON fallback"]
            SupaSSR["@supabase/ssr
            Server-side auth"]
        end
    end

    subgraph WebLegacy["Legacy Vanilla JS — apps/web :3003 (being retired)"]
        direction LR
        L_Pages["30 HTML pages
        dashboard, crm, deal, vdr,
        memo-builder, admin ..."]
        L_JS["39 JS modules
        PEAuth, financials,
        analysis, onboarding"]
    end

    subgraph API["Express + TypeScript API — apps/api :3001 (serverless on Vercel)"]
        direction TB
        subgraph Middleware["Middleware Stack (in order)"]
            direction LR
            MW_Compress["compression"]
            MW_Helmet["helmet
            CSP, HSTS"]
            MW_CORS["cors
            origin allowlist"]
            MW_RateLimit["rate-limit
            600/15min general
            10/min AI, 30/min write"]
            MW_Auth["authMiddleware
            Supabase JWT verify
            + MFA enforcement"]
            MW_Org["orgMiddleware
            org resolution + isolation"]
            MW_RBAC["rbacMiddleware
            ADMIN | MEMBER | VIEWER"]
        end

        subgraph Routes["92 Route Files — /api/* (app-lite core + app-ai)"]
            direction LR
            R_Deals["Deals
            deals, analysis, chat,
            team, import, scorecard"]
            R_Share["Sharing
            deal-shares (create/revoke)
            portal (public, token)"]
            R_Docs["Documents + VDR
            upload, folders, insights"]
            R_Fin["Financials
            extraction, merge,
            analysis, memo"]
            R_Memos["Memos
            memos, sections, chat,
            generate-all (SSE)"]
            R_Ingest["Ingest
            upload, drive, url,
            email, text, bulk"]
            R_Integrations["Integrations
            gmail, outlook, hubspot,
            legal-documents"]
            R_Sys["System
            users, invitations, audit,
            usage, notifications, tasks"]
        end

        subgraph Services["Service Layer"]
            direction LR
            S_AI["services/ai — Anthropic client
            trackedClaudeMessage / Stream
            role→model map · Files API
            writes UsageEvent + AuditLog"]
            S_LLM["llm.ts — legacy unified LLM
            (flag-off paths)"]
            S_Fin["Financial extraction
            claudeEngine (native PDF) +
            legacy: classifier, azure,
            vision, excel, llamaParse"]
            S_Analysis["analysis/ — PE engine
            QoE, ratios, red flags,
            debt-LBO"]
            S_Other["Misc services
            dealMerger, aiExtractor,
            embeddings, audit, teasers"]
        end

        subgraph Agents["13 AI Agents — services/agents/"]
            direction LR
            A_Fin["Financial Agent
            LangGraph: extract → validate
            → cross-verify → self-correct
            → store (EXTRACTION_ENGINE flag)"]
            A_Memo["Memo Agent
            generate 12 sections (streamed)
            → rubric critique → revise"]
            A_DealChat["Deal Chat Agent
            14 tools · dual barrels
            (DEAL_CHAT_ENGINE flag)"]
            A_Score["Deal Scorecard
            quality + thesis fit
            → GO / NO-GO (auto re-score)"]
            A_Firm["Firm Research +
            Signal Monitor
            (RESEARCH/SIGNAL_ENGINE flags)"]
            A_More["contact enrichment,
            meeting prep, email drafter,
            global chat, transcript ..."]
        end
    end

    Flags["Feature flags (env)
    EXTRACTION_ENGINE legacy→claude (bake-off pending)
    DEAL_CHAT_ENGINE legacy→streaming (4-tool port pending)
    RESEARCH_ENGINE / SIGNAL_ENGINE off (2-B provisioning)"]

    subgraph External["External Services"]
        direction LR
        Supabase["Supabase
        PostgreSQL (RLS backstop)
        + Auth (JWT/MFA) + Storage"]
        Anthropic["Anthropic API — PRIMARY
        Fable 5 — extraction (native PDF)
        Sonnet 5 — chat + memo
        Haiku 4.5 — fast"]
        OpenAI["OpenAI / OpenRouter
        legacy engines (flag-off)"]
        AzureDI["Azure Doc Intelligence
        legacy PDF fallback"]
        LlamaParse["LlamaParse
        legacy deep PDF parsing"]
        Apify["Apify
        research scraping"]
        Resend["Resend
        invites + share emails"]
        Sentry["Sentry"]
        Vercel["Vercel
        single deployment
        (root dir: apps/web-next)"]
    end

    WebNext -->|"fetch → /api/* proxy
    JWT Bearer token · SSE streams"| API
    WebLegacy -->|"PEAuth.authFetch()"| API
    API -->|"Supabase JS client
    org-scoped queries + storage"| Supabase
    S_AI -->|"Anthropic SDK
    structured output · streaming
    Files API uploads"| Anthropic
    S_LLM -.->|"legacy flags off"| OpenAI
    S_Fin -.->|"legacy chain"| AzureDI
    S_Fin -.->|"legacy chain"| LlamaParse
    API -->|"apify-client"| Apify
    API -->|"Resend SDK"| Resend
    API -.->|"NODE_ENV=production"| Sentry
    WebNext -.->|"deploy"| Vercel
    API -.->|"deploy serverless"| Vercel
    Flags -.- Agents
    A_Fin -->|"FinancialStatement rows
    + deal cache writeback"| Supabase
    A_Fin -->|"auto re-score"| A_Score

