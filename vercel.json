{
  "version": 2,
  "installCommand": "rm -f package-lock.json && npm install --include=dev",
  "buildCommand": "npm run build:api && npm run build --workspace=@ai-crm/web-next",
  "outputDirectory": "apps/web-next/.next",
  "functions": {
    "apps/web-next/src/app/api/[...slug]/route.ts": {
      "memory": 1769,
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/signal-scan",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/integrations/_cron/sync-all",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/doc-request-reminders",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/reactivation",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 8 * * 1"
    },
    {
      "path": "/api/cron/share-expiry-warnings",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/reengagement-nudge",
      "schedule": "0 10 * * 1"
    }
  ]
}
